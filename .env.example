# StoryPad Environment Configuration Example
# Salin file ini menjadi .env lalu isi dengan nilai environment proyek Anda.
STORYPAD_STUDIO_NAME="Kelompok 10"

# Supabase Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_STORAGE_BUCKET="storypad-media"

# Admin Portal Configuration
STORYPAD_ADMIN_AUTH_MODE="hybrid"
STORYPAD_ADMIN_EMAILS="admin@storypad.local"
STORYPAD_ADMIN_NAME="Admin Produksi"
STORYPAD_ADMIN_INITIALS="AD"
STORYPAD_ADMIN_EMAIL="admin@storypad.local"
STORYPAD_ADMIN_ROLE="Koordinator Produksi"
# Buat hash dengan: php -r "echo password_hash('kata-sandi-kuat-anda', PASSWORD_BCRYPT);"
STORYPAD_ADMIN_PASSWORD_HASH=""
